{
  "name": "himalayan-voyage-nepal",
  "version": "1.0.0",
  "private": true,
  "description": "Travel agency website \u2014 Nepal tours, international packages, trekking, and visa services. Original implementation with a JWT-protected admin CMS.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "test": "node test.js",
    "docs": "node scripts/generate-docs.js",
    "images": "node scripts/fetch-images.js",
    "pages": "node scripts/generate-visa-pages.js",
    "build:assets": "node scripts/fetch-images.js && node scripts/generate-docs.js && node scripts/generate-visa-pages.js && node scripts/bust-cache.js",
    "version": "node scripts/bust-cache.js",
    "admin:pass": "node scripts/admin-password.js",
    "migrate:pg": "node scripts/sqlite-to-pg.js",
    "migrate:verify": "node scripts/sqlite-to-pg.js --verify-only",
    "test:persist": "node scripts/persistence-test.js",
    "db:migrate": "node -e \"require('./src/db').init().then(k=>console.log('schema ready on',k))\"",
    "db:set-url": "node scripts/set-db-url.js",
    "migrate:apply": "CONFIRM_MIGRATION=yes node scripts/sqlite-to-pg.js",
    "backup": "node scripts/backup-db.js",
    "uptime": "node scripts/uptime-check.js",
    "uptime:watch": "node scripts/uptime-check.js --watch",
    "lint": "npx eslint server.js src/ scripts/backup-db.js scripts/uptime-check.js scripts/secret-scan.js scripts/deploy-verify.js scripts/ops-status.js scripts/backup-schedule.js scripts/rollback.js",
    "secret-scan": "node scripts/secret-scan.js",
    "secret-scan:staged": "node scripts/secret-scan.js --staged",
    "deploy:verify": "node scripts/deploy-verify.js",
    "ops": "node scripts/ops-status.js",
    "backup:schedule": "node scripts/backup-schedule.js",
    "backup:restore-test": "node scripts/backup-schedule.js --restore-test",
    "rollback": "node scripts/rollback.js",
    "ci": "npm run lint && npm run secret-scan && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
