# Copy to .env and change these values in production.

# Port the HTTP server listens on
PORT=3400

# Secret used to sign admin JWTs — MUST be a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database ------------------------------------------------------------
# Leave DATABASE_URL unset to use the built-in SQLite file (zero-config, used
# for local development). Set it to a PostgreSQL connection string to get
# persistent storage in production:
#
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Nothing else needs to change — the app picks the driver automatically.
# DATABASE_URL=

# SQLite fallback path (only used when DATABASE_URL is unset)
# DB_PATH=./data/travel.db

# Optional: max PostgreSQL pool connections (default 5)
# PG_POOL_MAX=5

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@himalayanvoyage.test
ADMIN_PASSWORD=admin12345

# ---- Booking notifications (OPTIONAL) ------------------------------------
# Leave all of these unset and bookings still work — the app simply records the
# enquiry and notifies nobody. Set ONE provider to receive an email for each new
# booking. Values are NEVER printed by the app; keep them out of source control.
#
# Option A — HTTP email API (no SMTP firewall issues on free hosts):
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   (or SENDGRID_API_KEY=SG.xxxx)
#
# Option B — SMTP relay (works with any provider, sent over the core net/tls
#            modules so no npm package is required):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USER=your-smtp-user
#   SMTP_PASS=your-smtp-password
#
# Required with either option:
#   NOTIFY_FROM=bookings@your-domain.com
#   NOTIFY_TO=owner@your-domain.com
