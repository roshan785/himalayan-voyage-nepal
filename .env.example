# ─────────────────────────────────────────────────────────────────────────────
# Himalayan Voyage Nepal — environment template
#
# Copy to `.env` for local development and fill in real values.
# In PRODUCTION (Render) these are set in the dashboard, NOT here.
# This file must NEVER contain real secrets. It is a checklist, not a store.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Port the server listens on.
PORT=3400
# Prefer 0.0.0.0 so it is reachable from a LAN / container.
HOST=0.0.0.0
# Set to "production" on the live host (enables Secure cookies).
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Leave UNSET for the zero-config local SQLite file.
# In production set the PostgreSQL URL (Neon / Supabase / Render):
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string. Generate with:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
# Default admin created on first boot when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Public origin (REQUIRED for real payments) ───────────────────────────────
# The absolute, HTTPS origin of the live site. Payment gateways redirect the
# customer back here, so it MUST be reachable from the internet.
# Production: https://himalayan-voyage-nepal-0sem.onrender.com
PUBLIC_BASE_URL=

# ── Payment environment switch ────────────────────────────────────────────────
# "sandbox"    -> eSewa rc-epay host + Khalti dev host   (SAFE, default)
# "production" -> eSewa live host + Khalti live host     (REAL MONEY)
# Mock payments are automatically DISABLED when this is "production".
PAYMENT_ENV=sandbox
# Only for a deliberate production rehearsal. Leave unset/false normally.
# ALLOW_MOCK_PAYMENTS=false

# ── eSewa ePay v2 ─────────────────────────────────────────────────────────────
# Obtain from your eSewa merchant account (merchant.esewa.com.np).
#   Sandbox : product_code EPAYTEST + its published secret (integration only).
#   Live    : your live product/service code + merchant secret key.
# Endpoint hosts (override only if eSewa issues a different one):
#   sandbox    https://rc-epay.esewa.com.np
#   production https://epay.esewa.com.np
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# ESEWA_BASE_URL=

# ── Khalti ePayment v2 ────────────────────────────────────────────────────────
# Obtain the live_secret_key from admin.khalti.com (live) or
# test-admin.khalti.com (sandbox).
# Endpoint hosts:
#   sandbox    https://dev.khalti.com/api/v2
#   production https://khalti.com/api/v2
KHALTI_SECRET_KEY=
# KHALTI_BASE_URL=

# ── Optional: email notifications ─────────────────────────────────────────────
# Order/booking emails are best-effort; with none set they are silently skipped.
# HTTP API (resend.com / sendgrid.com):
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# Or SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
